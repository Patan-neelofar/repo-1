<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Portfolio</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: "Poppins", sans-serif;
      color: #333;
      line-height: 1.6;
    }

    header {
      background: #4a90e2;
      padding: 1rem 0;
      color: white;
      text-align: center;
    }

    nav h1 {
      margin-bottom: 0.5rem;
    }

    .nav-links {
      list-style: none;
      display: flex;
      justify-content: center;
      gap: 1rem;
    }

    .nav-links a {
      color: white;
      text-decoration: none;
      font-weight: 500;
    }

    #hero {
      text-align: center;
      padding: 4rem 1rem;
      background: #f4f4f4;
    }

    .btn {
      display: inline-block;
      background: #4a90e2;
      color: white;
      padding: 0.6rem 1.2rem;
      border-radius: 5px;
      text-decoration: none;
      margin-top: 1rem;
      transition: background 0.3s;
    }

    .btn:hover {
      background: #357abd;
    }

    section {
      padding: 2rem 1rem;
      text-align: center;
    }

    .project-list {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .project-card {
      background: #e3f2fd;
      padding: 1rem;
      border-radius: 10px;
      width: 250px;
      box-shadow: 0 0 5px rgba(0,0,0,0.1);
      transition: transform 0.3s;
    }

    .project-card:hover {
      transform: translateY(-5px);
    }

    form {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      max-width: 400px;
      margin: auto;
    }

    input, textarea {
      width: 100%;
      padding: 0.8rem;
      border: 1px solid #ccc;
      border-radius: 5px;
    }

    footer {
      background: #4a90e2;
      color: white;
      text-align: center;
      padding: 1rem 0;
      margin-top: 2rem;
    }

    @media (max-width: 768px) {
      .project-list {
        flex-direction: column;
        align-items: center;
      }
    }
  </style>
</head>
<body>
  <header>
    <nav>
      <h1>My Portfolio</h1>
      <ul class="nav-links">
        <li><a href="#about">About</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <section id="hero">
    <h2>Hi, I'm Neelofar 👋</h2>
    <p>I'm a Web Developer passionate about creating responsive and clean websites.</p>
    <a href="#projects" class="btn">View My Work</a
